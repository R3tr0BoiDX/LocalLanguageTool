# Copy to .env and adjust: cp .env.example .env

# Address the port is published on. 0.0.0.0 = reachable from the whole LAN,
# 127.0.0.1 = only from the host itself, or a specific LAN IP of the host.
LT_BIND=0.0.0.0
LT_PORT=8010

# Where the n-gram data lives on the host (see download.sh).
# Point this to an NVMe/SSD mount once available, e.g. /mnt/nvme/ngrams
NGRAMS_DIR=./ngrams

# Java heap. 2g is comfortable for de + en with n-grams on an 8 GB Pi 5.
JAVA_XMS=512m
JAVA_XMX=2g

# Hard memory cap for the container (heap + JVM overhead + fastText).
LT_MEM_LIMIT=3g
